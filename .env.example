# Names only — put real values in Vercel (Preview environment first), never in Git.
# --- DBByte thumbnail storage (server-side only; none of these are NEXT_PUBLIC_*) ---
DBBYTE_API_KEY=              # SECRET. API key with read+write+delete on the thumbnail bucket
DBBYTE_BUCKET=               # bucket slug, e.g. onfile-thumbnails (PUBLIC bucket, CDN enabled)
DBBYTE_CDN_BASE_URL=         # https://cdn.dbbyte.com/<public-token>   (public delivery prefix, not a secret)
# DBBYTE_API_BASE_URL=https://api.dbbyte.com   # optional override
# --- Admin storage page ---
ADMIN_TELEGRAM_IDS=          # comma-separated Telegram user ids allowed to open /admin/storage
# --- Optional usage thresholds (percent) ---
# THUMB_WARN_PCT=70
# THUMB_HIGH_PCT=80
# THUMB_BLOCK_PCT=90
