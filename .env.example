# --- Database (Postgres; use a DIRECT connection for drizzle-kit) ---
DATABASE_URL=                # e.g. postgresql://user:password@host:5432/dbname

# Names only — put real values in Vercel (Preview environment first), never in Git.
# --- DBByte thumbnail storage (server-side only; none of these are NEXT_PUBLIC_*) ---
DBBYTE_API_KEY=              # SECRET. API key with read+write+delete on the thumbnail bucket
DBBYTE_BUCKET=               # bucket slug, e.g. onfile-thumbnails (PUBLIC bucket, CDN enabled)
DBBYTE_CDN_BASE_URL=         # https://cdn.dbbyte.com/<public-token>   (public delivery prefix, not a secret)
# DBBYTE_API_BASE_URL=https://api.dbbyte.com   # optional override
# --- Admin storage page ---
ADMIN_TELEGRAM_IDS=          # comma-separated Telegram user ids allowed to open /admin/storage
# --- Optional usage thresholds (percent) ---
# THUMB_WARN_PCT=70
# THUMB_HIGH_PCT=80
# THUMB_BLOCK_PCT=90
# --- Storage provider selection (optional; default "dbbyte"). Unknown value => thumbnails reported as unavailable. ---
# THUMBNAIL_STORAGE_PROVIDER=dbbyte

# --- Telegram bot (server-side secrets: never NEXT_PUBLIC_*) ---
TELEGRAM_BOT_TOKEN=          # SECRET. Bot token from @BotFather
TELEGRAM_WEBHOOK_SECRET=     # SECRET. Same value you pass as `secret_token` to setWebhook (see scripts/configure-telegram-webhook.mjs)
SETUP_TOKEN_SECRET=          # SECRET (optional). Signs setup cookies + bot start payloads; falls back to TELEGRAM_BOT_TOKEN

# --- Bot-guided channel connection: "Verify" button ---
# REQUIRED in Production: public https origin of the Mini App, e.g. MINI_APP_URL=https://onfile-app.vercel.app (no secret).
# Used ONLY to build the `web_app` button URL (<origin>/?connect=<public request ref>). Explicit fallbacks, in order:
# NEXT_PUBLIC_APP_URL, then VERCEL_PROJECT_PRODUCTION_URL (production deployments only). VERCEL_URL is NOT used.
# Without any https URL the verification message is still sent but WITHOUT the button, and an error naming MINI_APP_URL is logged.
MINI_APP_URL=
