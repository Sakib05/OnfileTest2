# ─────────────────────────────────────────────────────────────────────────────
# Onfile — environment template (copy to .env.local / Vercel Project Settings).
# NEVER commit real values. Nothing below is exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Existing app variables (unchanged)
DATABASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MINI_APP_SHORT_NAME=

# ── Thumbnail storage: administration & automation ───────────────────────────
# Comma-separated numeric Telegram user ids allowed to open /admin/storage and
# receive Telegram alerts. Empty => nobody is an admin (fail closed).
ADMIN_TELEGRAM_IDS=
# >=16 random chars. Vercel Cron automatically sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# ── ImageKit (images uploaded as PRIVATE files; delivery via signed ik-s/ik-t URLs) ──
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# Optional one-time quota seeds (read only when the provider row is first created;
# afterwards edit them in the admin dashboard). Check YOUR dashboard for real limits.
# IMAGEKIT_STORAGE_QUOTA_BYTES=
# IMAGEKIT_BANDWIDTH_QUOTA_BYTES=
# IMAGEKIT_BILLING_CYCLE_DAY=1

# ── Cloudinary (type=authenticated; delivered through Onfile's server — see docs) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Free plans are credit-based: set byte quotas manually if you want Onfile to enforce them.
# CLOUDINARY_STORAGE_QUOTA_BYTES=
# CLOUDINARY_BANDWIDTH_QUOTA_BYTES=

# ── Supabase Storage (PRIVATE bucket; short-lived signed URLs) ──
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_THUMBNAIL_BUCKET=onfile-thumbnails
# SUPABASE_STORAGE_QUOTA_BYTES=
# SUPABASE_BANDWIDTH_QUOTA_BYTES=

# ── DBByte (REST API, private bucket, signed URLs) ──
DBBYTE_API_KEY=
DBBYTE_BUCKET=
# DBBYTE_BASE_URL=https://api.dbbyte.com
# If no DBBYTE_*_QUOTA vars are set, the first run seeds the values you observed in the
# DBByte dashboard (20 GB storage, 100 GB/month bandwidth, 10K requests/month) as MANUAL.
# DBBYTE_STORAGE_QUOTA_BYTES=
# DBBYTE_BANDWIDTH_QUOTA_BYTES=
# DBBYTE_REQUEST_QUOTA=
# DBBYTE_BILLING_CYCLE_DAY=
